# ==============================================================================
# MERIDIAN PRESS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
# Public base URL of your deployed bookstore (used for emails & redirects)
NEXT_PUBLIC_APP_URL=https://meridianpress.pub
PORT=3000

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (INR ₹ PAYMENTS)
# ------------------------------------------------------------------------------
# Obtain from https://dashboard.razorpay.com/app/keys
# Key ID (Public - used on client & server)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# Key Secret (Server-only - NEVER EXPOSE TO CLIENT)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret (Configured under Razorpay Dashboard > Settings > Webhooks)
# Webhook URL to configure: https://meridianpress.pub/api/payments/razorpay/webhook
# Events to subscribe: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. PERSISTENT POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Compatible with Neon, Supabase, Vercel Postgres, AWS RDS, Railway, etc.
# If omitted during local development, falls back automatically to local file storage.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/meridian_press?sslmode=require

# ------------------------------------------------------------------------------
# 4. PUBLISHER ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong server secret for editorial access to /admin
# Required in production; no hardcoded defaults are trusted.
ADMIN_SECRET=generate_a_strong_random_secret_passcode_here

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL DELIVERY (RESEND / SMTP)
# ------------------------------------------------------------------------------
# Optional: If configured, delivers instant order receipts & recovery links.
# If omitted, order links are displayed on the confirmation page & logged to console.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Meridian Press <orders@meridianpress.pub>
